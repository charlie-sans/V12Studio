<Project>

  <!--
    V12 is consumed from the sibling V12-Monorepo checkout (the standard local
    layout: D:\git\V12Studio + D:\git\V12-Monorepo). The monorepo root props
    below redirect every V12*Project path to its sibling checkouts, so the
    studio has no vendored libs/ submodules.

    Point V12MonorepoRoot (or the individual V12*Project paths) elsewhere with
    -p: overrides if your checkouts live in a different place.
  -->
  <PropertyGroup>
    <V12MonorepoRoot Condition="'$(V12MonorepoRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\V12-Monorepo'))\</V12MonorepoRoot>
    <V12NovaProject Condition="'$(V12NovaProject)' == ''">$(V12MonorepoRoot)Nova\V12TwoDog.2dog\V12TwoDog.csproj</V12NovaProject>
    <V12NovaSharedProject Condition="'$(V12NovaSharedProject)' == ''">$(V12MonorepoRoot)Nova\Nova.Shared\Nova.Shared.csproj</V12NovaSharedProject>
    <NoWarn>$(NoWarn);CS1591;CS1998;CS8625;CS8618;CA1822</NoWarn>
  </PropertyGroup>

  <Import Project="$(V12MonorepoRoot)Directory.Build.props" Condition="Exists('$(V12MonorepoRoot)Directory.Build.props')" />

</Project>
