<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- wipe machine/user-level sources so every clone restores identically -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- repo-local feed: output of pack-feed.ps1 (nupkgs are gitignored) -->
    <add key="V12Feed" value="feed" />
    <!-- GitHub Packages, once someone enables it: credentials live in the
         user-level NuGet config (dotnet nuget add source ...), never here -->
    <add key="github" value="https://nuget.pkg.github.com/Fy-nite/index.json" />
  </packageSources>

  <disabledPackageSources>
    <add key="github" value="true" />
  </disabledPackageSources>

  <!-- V12's own packages resolve from the repo feed; everything else from nuget.org -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="V12Feed">
      <package pattern="Finite.*" />
      <package pattern="V12.*" />
      <package pattern="Contract.*" />
      <package pattern="ObjectRT.*" />
      <package pattern="ObjektRT.*" />
      <package pattern="Prowl.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
