<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Keep the default public repository -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Force fallback evaluation into your local custom Tracy build output -->
    <add key="LocalGodot4.8" value="D:\git\godot\bin\nupkg" />
  </packageSources>
  <packageSourceMapping>
    <!-- Godot's SDK/Sharp packages only come from the custom Tracy build -->
    <packageSource key="LocalGodot4.8">
      <package pattern="Godot.*" />
    </packageSource>
    <packageSource key="V12Feed">
      <package pattern="Finite.*" />
      <package pattern="V12.*" />
      <package pattern="Contract.*" />
      <package pattern="ObjectRT.*" />
      <package pattern="ObjektRT.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Prowl.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>