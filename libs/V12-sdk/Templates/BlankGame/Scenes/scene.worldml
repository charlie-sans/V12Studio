<?xml version=""1.0"" encoding=""UTF-8""?>
<World WorldName=""{{PROJECT_NAME}}"" xmlns=""http://v12-studio.org/WorldML/1.0"">
  <Element Name=""Sun"">
    <Component Type=""GenericLightComponent"">
      <Type>Directional</Type>
      <ColorR>1</ColorR>
      <ColorG>0.97</ColorG>
      <ColorB>0.92</ColorB>
      <Energy>1.2</Energy>
    </Component>
    <LocalTransform>
      <Position>0,8,4</Position>
      <Rotation>0,-0.6,-0.9,0</Rotation>
      <Scale>1,1,1</Scale>
    </LocalTransform>
  </Element>
  
  <Element Name=""Ground"">
    <Component Type=""MeshComponent"">
      <Shape>Box</Shape>
      <Width>12</Width>
      <Height>0.2</Height>
      <Depth>12</Depth>
    </Component>
    <Component Type=""MeshRenderer"">
      <Mesh>Refer to MeshComponent</Mesh>
    </Component>
    <Component Type=""MaterialComponent"">
      <R>0.24</R>
      <G>0.26</G>
      <B>0.3</B>
      <A>1</A>
      <Roughness>0.9</Roughness>
    </Component>
    <LocalTransform>
      <Position>0,-0.1,0</Position>
      <Rotation>0,0,0,0</Rotation>
      <Scale>1,1,1</Scale>
    </LocalTransform>
  </Element>
  
  <Element Name=""ViewportCamera"">
    <Component Type=""CameraComponent"">
      <Active>true</Active>
      <IsCurrent>true</IsCurrent>
      <Fov>60</Fov>
      <FarClip>1000</FarClip>
    </Component>
    <LocalTransform>
      <Position>0,2.6,7</Position>
      <Rotation>0,-0.35,0,0</Rotation>
      <Scale>1,1,1</Scale>
    </LocalTransform>
  </Element>
</World>
